# .env.prod.example — copy to .env.prod on homelab host, fill in values.
# NEVER commit .env.prod.

# ── Paths (homelab-specific) ────────────────────────────────────────────────
ECR_REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest
OBSIDIAN_JOBS_PATH=/home/<user>/Obsidian/References/Jobs
OUTPUT_PATH=/home/<user>/resume-output
DB_PATH=/home/<user>/resumeloop/resume.db
PIPELINE_DATA_PATH=/home/<user>/resumeloop/pipeline/master_resume_data.json

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=<random-string-min-32-chars>
NEXTAUTH_URL=https://<tailscale-hostname>

# ── Mode (local = SQLite + filesystem) ───────────────────────────────────────
APP_MODE=local

# ── Public demo mode ─────────────────────────────────────────────────────────
# DEMO_PUBLIC=1 forces every session onto the local Ollama model, disables
# credential signup, and blocks provider retargeting. Only set on the public
# demo box — never where a real BYOK account needs to work.
# DEMO_PUBLIC=1
# DEMO_OLLAMA_MODEL=gemma4:e2b
# DEMO_OLLAMA_BASE_URL=http://ollama:11434/v1
# Box-wide concurrent inference slots (keep OLLAMA_NUM_PARALLEL in agreement)
# DEMO_MAX_CONCURRENT_INFERENCE=1
# How long a request waits for a slot before shedding load (429)
# DEMO_QUEUE_WAIT_MS=5000
# Wall-clock ceiling per chat turn
# DEMO_CHAT_TIMEOUT_MS=90000
# Per-call generation timeouts — set from the on-box benchmark (CPU-only may need more)
# AI_REASON_TIMEOUT_MS=60000
# AI_REASON_RETRY_TIMEOUT_MS=120000
# Host circuit breaker: refuse new inference when load1/cores or free RAM crosses these
# HOST_GUARD_LOAD_THRESHOLD=1.5
# HOST_GUARD_MIN_FREE_MEM_PCT=0.1
# Cloudflare Tunnel token (Cloudflare Zero Trust dashboard → Tunnels)
# CF_TUNNEL_TOKEN=<from dashboard>
# GRAFANA_ADMIN_PASSWORD=<pick one>

# ── Metrics ──────────────────────────────────────────────────────────────────
# Bearer token for /api/metrics/prometheus. Also write it (no trailing newline)
# to infra/prometheus/metrics-token for the compose Prometheus service.
# METRICS_TOKEN=<generate with: openssl rand -hex 32>

# ── LLM (Ollama on host, or configure via Settings UI after first login) ─────
# LITELLM_URL=http://host.docker.internal:11434/v1
# LITELLM_MODEL=gemma4:e2b

# ── Encryption key for stored API keys ───────────────────────────────────────
ENCRYPTION_KEY=<32-byte-hex-string>

# ── Batch concurrency ────────────────────────────────────────────────────────
BATCH_CONCURRENCY=3

# ── Logs API ──────────────────────────────────────────────────────────────────
# Optional: enables Bearer token auth on /api/logs endpoints
# LOGS_API_KEY=<generate with: openssl rand -hex 32>

# ── Giscus (feedback page) ────────────────────────────────────────────────────
# IDs are hardcoded in GiscusWidget.tsx — no env vars needed.
